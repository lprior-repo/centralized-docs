#!/usr/bin/env bash
# TCR: The simplest possible AI constraint
# Tests pass = commit. Tests fail = delete.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Run Claude in a loop until tests pass
while true; do
    echo ""
    echo "╔════════════════════════════════════════╗"
    echo "║  TCR: Tests must pass to commit        ║"
    echo "╚════════════════════════════════════════╝"
    echo ""

    # Run Claude
    claude "$@"

    echo ""
    echo "=== TCR: Running tests ==="
    echo ""

    # Capture test output
    if TEST_OUTPUT=$(go test ./... -short 2>&1); then
        echo "$TEST_OUTPUT"
        echo ""
        echo "=== PASS: Committing ==="
        git add -A && git commit -m "TCR: tests pass" 2>/dev/null || true
        exit 0
    else
        echo "$TEST_OUTPUT"
        echo ""
        echo "=== FAIL: Changes reverted ==="
        echo ""
        git checkout -- . 2>/dev/null || true
        git clean -fd 2>/dev/null || true

        # Ask if they want to retry
        read -p "Retry with Claude? [Y/n] " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Nn]$ ]]; then
            echo "Exiting."
            exit 1
        fi
        # Loop continues, Claude runs again with context of failure
    fi
done
